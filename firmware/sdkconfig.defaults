# Minimal bring-up target: same SoC/flash layout as the RLCD 4.2 board.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_HZ=1000

# Console over the board's USB-Serial/JTAG (device appears as /dev/ttyACMx).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Acquire NTP servers from DHCP option 42 when the network provides them.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
